# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.

# "development" locally, "production" on a server. Controls the `secure` cookie
# flag, stack-trace redaction, and whether weak secrets are fatal at boot.
NODE_ENV=development

PORT=3000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# At least 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Required in production. Number of proxy hops in front of the app:
#   1 = one reverse proxy (Nginx, Render, Railway, Fly)
#   2 = Cloudflare in front of a reverse proxy
#   loopback = local development only
# Never "true": that trusts client-supplied X-Forwarded-For and bypasses
# every IP-based rate limit.
TRUST_PROXY=loopback

# Optional, defaults to 7.99. Must be a number.
SHIPPING_FEE=7.99
